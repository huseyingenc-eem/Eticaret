{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
      "ETicaret.Persistence.Diagnostics.SqlCommandLoggingInterceptor": "Information"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "ETicaret.Persistence.Diagnostics.SqlCommandLoggingInterceptor": "Information"
      }
    }
  },
  "EnableSqlLogging": true,
  "SqlCommandLogging": {
    "SlowThresholdMs": 50,
    "IncludeParameters": true,
    "MaxSqlChars": 3000,
    "EnableAnsiColor": true,
    "PrettyFormatSql": true,
    "LogBeforeExecute": true,
    "EchoToConsole": true
  },
  "SpaSettings": {
    "Enabled": false,
    "RootPath": "../../../moossaksesuar.client",
    "StartupCommand": "npm run dev",
    "ServerUrl": "http://localhost:5174",
    "ApiBasePath": "/api",
    "HotReload": true
  },
  "ConnectionStrings": {
    "SqlConnection": "server = (localdb)\\MSSQLLocalDB; Database = EticaretDb; Trusted_Connection=true",
    "RedisConnectionString": "localhost:6379"
  },
  "SerilogLogConfigurations": {
    "FileLogConfiguration": {
      "FolderPath": "logs/"
    }
  }
}